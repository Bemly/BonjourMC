<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GUI.App"
             xmlns:local="using:GUI"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Theme.axaml"/>

        <!-- Fix Avalonia 12 transparency bug on Windows (#21082) -->
        <Style Selector="Border#PART_WindowBorder">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Panel#PART_TitleBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Application.Styles>
</Application>

<UserControl x:Class="GUI.Controls.PclRadioButton"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Name="PART_Back" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="#01eaf2fe" CornerRadius="13.5" MinHeight="27" MaxHeight="27"
            Cursor="Hand" ClipToBounds="False">
        <StackPanel Orientation="Horizontal">
            <Path Name="PART_Logo" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5"
                  Margin="12,0,0,0" Stretch="Uniform" MaxHeight="16" MaxWidth="16"
                  VerticalAlignment="Center"/>
            <TextBlock Name="PART_Text" VerticalAlignment="Center"
                       Foreground="White" Margin="8,0,12,0"/>
        </StackPanel>
    </Border>
</UserControl>

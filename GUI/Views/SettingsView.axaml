<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GUI.ViewModels"
             xmlns:ctrl="using:GUI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="GUI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="Transparent">

    <ScrollViewer>
        <StackPanel Spacing="0" Margin="24,20,24,24">

            <!-- ============================================================
                 Card 1: Player Settings
                 ============================================================ -->
            <ctrl:Card>
                <StackPanel Spacing="14">
                    <TextBlock Text="Player" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource Brush1}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Player Name" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushGray2}"/>
                        <TextBox Text="{Binding username, Mode=TwoWay}"
                                 PlaceholderText="Enter your username"/>
                    </StackPanel>
                </StackPanel>
            </ctrl:Card>

            <!-- ============================================================
                 Card 2: Java Settings
                 ============================================================ -->
            <ctrl:Card>
                <StackPanel Spacing="14">
                    <TextBlock Text="Java" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource Brush1}"/>

                    <!-- Memory Allocation -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Memory Allocation" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushGray2}"/>
                            <TextBlock Text="{Binding memory_mb, StringFormat='{}{0} MB'}"
                                       FontSize="13" Foreground="{StaticResource Brush3}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Slider Minimum="512" Maximum="16384"
                                Value="{Binding memory_mb, Mode=TwoWay}"
                                TickFrequency="512" IsSnapToTickEnabled="True"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="512 MB" FontSize="11" Foreground="{StaticResource BrushGray4}"/>
                            <TextBlock Text="16384 MB" FontSize="11" Foreground="{StaticResource BrushGray4}"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Java Path -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Java Path" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushGray2}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding java_path, Mode=TwoWay}"
                                     PlaceholderText="Auto-detect (leave empty)"/>
                            <Button Grid.Column="1" Content="Browse"
                                    Classes="ghost" Padding="14,8"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ctrl:Card>

            <!-- ============================================================
                 Card 3: Game Settings
                 ============================================================ -->
            <ctrl:Card>
                <StackPanel Spacing="14">
                    <TextBlock Text="Game" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource Brush1}"/>

                    <!-- Game Directory -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Game Directory" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushGray2}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding game_dir, Mode=TwoWay}"
                                     PlaceholderText="Default (use .minecraft)"/>
                            <Button Grid.Column="1" Content="Browse"
                                    Classes="ghost" Padding="14,8"/>
                        </Grid>
                    </StackPanel>

                    <!-- Window Size -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Window Size" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushGray2}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding window_width, Mode=TwoWay}" Width="100"/>
                            <TextBlock Text="×" VerticalAlignment="Center" FontSize="16"
                                       Foreground="{StaticResource BrushGray3}"/>
                            <TextBox Text="{Binding window_height, Mode=TwoWay}" Width="100"/>
                            <TextBlock Text="pixels" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource BrushGray4}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ctrl:Card>

            <!-- ============================================================
                 Card 4: Save Button
                 ============================================================ -->
            <ctrl:Card Padding="20,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="💾 Save Settings"
                            Classes="primary"
                            Command="{Binding save_command}"
                            Padding="24,10" FontSize="14"/>
                    <TextBlock Text="{Binding status_text}"
                               Foreground="{StaticResource BrushGreen}"
                               VerticalAlignment="Center" FontSize="13"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </ctrl:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>

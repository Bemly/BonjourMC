<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GUI.ViewModels"
             xmlns:ctrl="using:GUI.Controls"
             xmlns:lang="using:GUI.Lang"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="GUI.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Background="Transparent">

    <Grid ColumnDefinitions="280,*">

        <!-- ============================================================
             Left Panel (White background — PCL-CE style)
             ============================================================ -->
        <Border Grid.Column="0" Background="#ffffff" CornerRadius="0,0,0,6">
            <Grid RowDefinitions="*,Auto">

                <!-- Top: MC Avatar + User Info -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="10">
                    <Border Width="64" Height="64" CornerRadius="12"
                            Background="{StaticResource Brush8}" HorizontalAlignment="Center">
                        <Path Data="M52.1,164.5c-1.4,0-3.1-0.5-4.2-1.3c-2.6-1.7-4-4.2-4-7V43.8c0-2.9,1.6-5.8,4.1-7c1.2-0.8,2.7-1.2,4.1-1.2c1.5,0,2.9,0.4,4.2,1.2L153.1,93c0,0,0.1,0,0.1,0.1c2.6,1.7,4,4.2,4,7c0,3-1.7,5.8-4.2,7.1l-96.8,56.2C55.1,164,53.5,164.5,52.1,164.5z M60.4,142.1l72.1-42.1L60.4,58.2V142.1z"
                              Fill="{StaticResource Brush3}" Stretch="Uniform"
                              Width="32" Height="32"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding username}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush1}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Source={x:Static lang:Lang.Instance}, Path=home_subtitle}" FontSize="11"
                               Foreground="{StaticResource BrushGray3}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Bottom: Download + Instance Buttons -->
                <StackPanel Grid.Row="1" Margin="20,0,20,20" Spacing="8">
                    <Button Content="{Binding Source={x:Static lang:Lang.Instance}, Path=home_download}"
                            Classes="primary"
                            Command="{Binding navigate_download_command}"
                            HorizontalAlignment="Stretch" Height="38"
                            FontSize="14" FontWeight="SemiBold"
                            CornerRadius="6"/>
                    <Button Content="{Binding Source={x:Static lang:Lang.Instance}, Path=home_instance}"
                            Classes="ghost"
                            Command="{Binding navigate_instance_command}"
                            HorizontalAlignment="Stretch" Height="38"
                            FontSize="14" FontWeight="SemiBold"
                            CornerRadius="6"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ============================================================
             Right Panel (Light blue — PCL-CE announcements)
             ============================================================ -->
        <Border Grid.Column="1" Background="{StaticResource Brush8}" Margin="0">
            <StackPanel Margin="24,20,24,24" Spacing="16">
                <TextBlock Text="{Binding Source={x:Static lang:Lang.Instance}, Path=home_announce}" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource Brush1}"/>
                <Border Background="{StaticResource BrushBgCard}" CornerRadius="8"
                        Padding="20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" OffsetY="1"
                                          Opacity="0.06" Color="#3c3c3c"/>
                    </Border.Effect>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Source={x:Static lang:Lang.Instance}, Path=home_no_announce}" FontSize="14"
                                   Foreground="{StaticResource BrushGray3}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>

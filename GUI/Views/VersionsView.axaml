<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GUI.ViewModels"
             xmlns:m="using:Launcher.Utility.Model.Mojang"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="560"
             x:Class="GUI.Views.VersionsView"
             x:DataType="vm:VersionsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
        <!-- 过滤栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <ComboBox SelectedItem="{Binding filter_type}" Width="120">
                <ComboBoxItem Content="Release" IsSelected="True"/>
                <ComboBoxItem Content="Snapshot"/>
                <ComboBoxItem Content="All"/>
            </ComboBox>
            <TextBox Watermark="Search versions..."
                     Text="{Binding search_text}"
                     Width="200"/>
            <Button Content="Refresh"
                    Command="{Binding refresh_command}"
                    IsEnabled="{Binding !is_loading}"/>
            <TextBlock Text="{Binding status_text}"
                       Foreground="Gray" VerticalAlignment="Center"
                       FontSize="12"/>
        </StackPanel>

        <!-- 下载进度 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12"
                    IsVisible="{Binding is_downloading}">
            <ProgressBar Value="{Binding download_progress}" Maximum="100"
                         Height="20" CornerRadius="4"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <TextBlock Text="{Binding download_phase}" FontSize="12" Foreground="Gray"/>
                <TextBlock Text="{Binding download_current_item}" FontSize="12"
                           Foreground="#666" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>

        <!-- 版本列表 -->
        <ListBox Grid.Row="2" ItemsSource="{Binding filtered_versions}"
                 Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="m:VersionEntry">
                    <Border Margin="0,2" Padding="12,10" CornerRadius="6"
                            Background="#f5f5f5">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding id}" FontWeight="SemiBold" FontSize="14"/>
                                    <Border Background="#e0e0e0" CornerRadius="4" Padding="6,2"
                                            IsVisible="{Binding type, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding type}" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding release_time}" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Download"
                                    Command="{Binding $parent[ListBox].((vm:VersionsViewModel)DataContext).download_command}"
                                    CommandParameter="{Binding id}"
                                    FontSize="12" Padding="12,4"
                                    Background="#2196F3" Foreground="White"
                                    CornerRadius="4" Cursor="Hand"
                                    Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Delete"
                                    Command="{Binding $parent[ListBox].((vm:VersionsViewModel)DataContext).delete_command}"
                                    CommandParameter="{Binding id}"
                                    FontSize="12" Padding="12,4"
                                    Background="#f44336" Foreground="White"
                                    CornerRadius="4" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 加载中 -->
        <TextBlock Grid.Row="3" Text="Loading..." FontSize="12" Foreground="Gray"
                   HorizontalAlignment="Center" Margin="0,8,0,0"
                   IsVisible="{Binding is_loading}"/>
    </Grid>
</UserControl>

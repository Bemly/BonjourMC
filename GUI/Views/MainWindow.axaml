<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="BonjourMC"
        Width="900" Height="560"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="200,*">
        <!-- 侧边栏 -->
        <Panel Grid.Column="0" Background="#1a1a2e">
            <StackPanel Margin="0,20,0,0">
                <!-- Logo -->
                <StackPanel Margin="20,0,20,20" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⛏" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="BonjourMC" FontSize="16" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 导航项 -->
                <ListBox ItemsSource="{Binding pages}"
                         SelectedItem="{Binding selected_page}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ViewModelBase">
                            <StackPanel Margin="16,8" Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding page_title}"
                                           FontSize="14"
                                           Foreground="#c0c0c0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="4,0"/>
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#2d2d44"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#252540"/>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </StackPanel>
        </Panel>

        <!-- 内容区域 -->
        <ContentControl Grid.Column="1"
                        Content="{Binding selected_page}"
                        Margin="0"/>
    </Grid>
</Window>

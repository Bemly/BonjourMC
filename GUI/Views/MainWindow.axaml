<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GUI.ViewModels"
        xmlns:ctrl="using:GUI.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="BonjourMC"
        Width="900" Height="560"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <StyleInclude Source="/Styles/Theme.axaml"/>
    </Window.Styles>

    <!-- Main container with shadow -->
    <Border CornerRadius="12" Background="#fbfbfb" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" OffsetY="0" Opacity="0.3" Color="#000000"/>
        </Border.Effect>

        <Grid RowDefinitions="48,*">

            <!-- ============================================================
                 Title Bar (48px, PCL-CE style)
                 ============================================================ -->
            <Border Grid.Row="0" Background="{StaticResource Brush3}" CornerRadius="12,12,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="⛏" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="BonjourMC" FontSize="14" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Navigation Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <RadioButton Classes="nav" Content="⌂ Home"
                                     IsChecked="True"
                                     Command="{Binding navigate_home_command}"/>
                        <RadioButton Classes="nav" Content="⬇ Versions"
                                     Command="{Binding navigate_versions_command}"/>
                        <RadioButton Classes="nav" Content="⚙ Settings"
                                     Command="{Binding navigate_settings_command}"/>
                        <RadioButton Classes="nav" Content="📋 Logs"
                                     Command="{Binding navigate_logs_command}"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0"
                                Margin="0,0,8,0" VerticalAlignment="Center">
                        <Button Classes="window-control" Content="—"
                                Command="{Binding minimize_command}"/>
                        <Button Classes="window-control" Content="✕"
                                Command="{Binding close_command}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================
                 Content Area
                 ============================================================ -->
            <Grid Grid.Row="1" ColumnDefinitions="200,*">

                <!-- Left Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource BrushBgSidebar}"
                        CornerRadius="0,0,0,12">
                    <StackPanel Margin="0,20,0,0">
                        <!-- User Avatar Area -->
                        <StackPanel Margin="20,0,20,24" Spacing="8">
                            <Border Width="56" Height="56" CornerRadius="12"
                                    Background="#2d2d44" HorizontalAlignment="Center">
                                <TextBlock Text="⛏" FontSize="28"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding username}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="BonjourMC Player"
                                       FontSize="11" Foreground="#888888"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Sidebar Divider -->
                        <Border Height="1" Background="#2a2a40" Margin="20,0,20,16"/>

                        <!-- Navigation Items (Visual, binds to same VMs) -->
                        <StackPanel Spacing="2" Margin="12,0">
                            <Button Classes="sidebar-item" Content="⌂  Home"
                                    Command="{Binding navigate_home_command}"/>
                            <Button Classes="sidebar-item" Content="⬇  Versions"
                                    Command="{Binding navigate_versions_command}"/>
                            <Button Classes="sidebar-item" Content="⚙  Settings"
                                    Command="{Binding navigate_settings_command}"/>
                            <Button Classes="sidebar-item" Content="📋  Logs"
                                    Command="{Binding navigate_logs_command}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right Content with Page Transition -->
                <ctrl:PageTransition Grid.Column="1"
                                     Content="{Binding selected_page}"
                                     Margin="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
